# ---------------------------------------------------------------------------
# Settings seed (app_settings) — NOT the runtime process env.
#
# Copy to `.env.settings` on the server (gitignored), fill passwords, then
# boot the API once. Nest seeds an empty `app_settings` table from this file
# and encrypts *_PASSWORD with SETTINGS_SECRET_KEY from `.env.production`.
#
# After a successful first boot you may delete `.env.settings` from the host;
# further edits go through FE /config (or yarn settings:sync-from-env).
#
# Runtime `.env` / `.env.production` stay infrastructure-only (DB, Redis, JWT,
# SETTINGS_SECRET_KEY). See `.env.production.example`.
# ---------------------------------------------------------------------------

# Volumes (inside container → bind-mounted disk)
BACKUP_ROOT=/app/backup-storage
BACKUP_VOLUME_META=/app/backup-storage/meta
BACKUP_VOLUME_HIS=/app/backup-storage/his
BACKUP_VOLUME_EMR=/app/backup-storage/emr
BACKUP_VOLUME_LIS=/app/backup-storage/lis
BACKUP_DEV_ROW_LIMIT=0

BACKUP_SCHEDULE_ENABLED=true
BACKUP_TIMEZONE=Asia/Ho_Chi_Minh
BACKUP_INCREMENTAL_CRON=0 */4 * * *
BACKUP_HIS_INCREMENTAL_CRON=0 */4 * * *
BACKUP_EMR_INCREMENTAL_CRON=30 */4 * * *
BACKUP_LIS_INCREMENTAL_CRON=0 */4 * * *
BACKUP_HIS_FULL_CRON=30 1 * * 0
BACKUP_EMR_FULL_CRON=30 2 * * 0
BACKUP_LIS_FULL_CRON=30 3 * * 0

BACKUP_HISTORY_ENABLED=true
BACKUP_RETENTION_DAYS=15
BACKUP_FRESHNESS_MAX_AGE_HOURS=5
BACKUP_ARCHIVE_TARGET=none

# Sources — always SECONDARY hosts. Passwords encrypted into DB on seed.
HIS_HOST=172.16.16.23
HIS_PORT=5432
HIS_USER=his_stpaul
HIS_PASSWORD=
HIS_DATABASES=produce

EMR_HOST=172.16.16.23
EMR_PORT=5432
EMR_USER=emr_stpaul
EMR_PASSWORD=
EMR_DATABASES=signer,file_service,vital_signs,research_management,medical_incident,html_editor,phat_thuoc

LIS_HOST=192.168.105.2
LIS_PORT=1433
LIS_USER=thongke
LIS_PASSWORD=
LIS_DATABASES=BloodStorage_XanhPon,Labconnect_Card,LabconnXP,LabInventory_XP

# Leave empty until BADL secondary is reachable
BADL_HOST=
BADL_PORT=5432
BADL_USER=
BADL_PASSWORD=
BADL_DATABASES=

ALERT_TELEGRAM_ENABLED=false
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_SECURE=false
ALERT_DISK_FREE_THRESHOLD_PERCENT=15
