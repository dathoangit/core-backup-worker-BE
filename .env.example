# Server deploy: NODE_ENV=production and BACKUP_DEV_ROW_LIMIT=0 (required).
# Local sample dumps: NODE_ENV=development (forces row limit 100 if unset/0).
NODE_ENV=production

# ---------------------------------------------------------------------------
# Runtime env only. Sources / volumes / cron / retention / alerts →
# `.env.settings` (seed) then app_settings (FE /config).
# See `.env.settings.example`. Docker compose + deploy.sh use this `.env` file.
# ---------------------------------------------------------------------------

# App
PORT=8081
TRANSPORT_PORT=8081
ENABLE_DOCUMENTATION=true
API_VERSION=v1.0.0
FALLBACK_LANGUAGE=en

# Auth (required)
JWT_EXPIRATION_TIME=86400
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-rs256-private-key\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-rs256-public-key\n-----END PUBLIC KEY-----"
RESET_TOKEN_TTL_MINUTES=30
FRONTEND_ORIGINS=http://localhost:3000
# AUTH_COOKIE_SECURE=false

# App database (NestJS / TypeORM) — separate from HIS/EMR/LIS sources
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=core-backup-worker
TYPEORM_MIGRATIONS_RUN=false

# Encrypts *_PASSWORD in app_settings (required for secrets)
SETTINGS_SECRET_KEY=change-me-to-a-long-random-secret
# First-boot seed file (allowlisted settings; not loaded into process.env)
SETTINGS_SEED_FILE=.env.settings

# Redis
REDIS_CACHE_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_BULL_DB=1
REDIS_PASSWORD=

# Optional (unused unless archive target is s3)
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET_NAME_REGION=

# Compression (zstd recommended)
BACKUP_COMPRESSION=zstd
BACKUP_ZSTD_LEVEL=3
BACKUP_ZSTD_THREADS=4
BACKUP_VERIFY_ARCHIVE=true
BACKUP_MIN_FREE_GB=50
BACKUP_HIS_LOGICAL_CRON=0 4 * * 0
BACKUP_EMR_LOGICAL_CRON=0 5 * * 0
BACKUP_LOGICAL_JOBS=4
BACKUP_LOGICAL_EXCLUDE_TABLE_DATA=adempiere.ad_changelog
