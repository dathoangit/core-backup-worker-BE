NODE_ENV=development

# App
PORT=8081
TRANSPORT_PORT=8081
ENABLE_DOCUMENTATION=true
API_VERSION=v1.0.0
FALLBACK_LANGUAGE=en

# Auth (required)
JWT_EXPIRATION_TIME=86400
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-rs256-private-key\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-rs256-public-key\n-----END PUBLIC KEY-----"
RESET_TOKEN_TTL_MINUTES=30

# App database (NestJS / TypeORM) — separate from HIS source
# Supported values: postgres | mysql
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=mysql
DB_DATABASE=his-raw-backup
TYPEORM_MIGRATIONS_RUN=false

# Encrypts HIS/EMR/BADL passwords stored in app_settings (required for secrets)
# 64-char hex, base64 32-byte, or any passphrase
SETTINGS_SECRET_KEY=change-me-to-a-long-random-secret

# ---------------------------------------------------------------------------
# HIS source (StPaul). Always use SECONDARY hosts.
#   HIS/EMR: 172.16.16.23
#   BADL:    172.16.16.83
# ---------------------------------------------------------------------------
HIS_HOST=172.16.16.23
HIS_PORT=5432
HIS_USER=his_stpaul
HIS_PASSWORD=
HIS_DATABASES=produce

EMR_HOST=172.16.16.23
EMR_PORT=5432
EMR_USER=emr_stpaul
EMR_PASSWORD=
EMR_DATABASES=signer,file_service,vital_signs,research_management,medical_incident,html_editor,phat_thuoc

BADL_HOST=172.16.16.83
BADL_PORT=5432
BADL_USER=badl_stpaul
BADL_PASSWORD=
BADL_DATABASES=his

# MSSQL source (SQL Server Enterprise, SQL Server Authentication)
# Default instance MSSQLSERVER on LABSERVER. LabconnXP is a database, not an instance.
MSSQL_HOST=192.168.105.2
MSSQL_PORT=1433
MSSQL_USER=thongke
MSSQL_PASSWORD=your_password
MSSQL_DATABASE=master

# Incremental backup (yarn backup:run or Nest scheduler)
#
# Multi-volume layout (group volumes — not per-DB):
#   meta → backup.lock (+ optional meta manifest)
#   his  → produce artifacts
#   emr  → EMR DB artifacts
#
# yarn dev  → NODE_ENV=development; loads .env.development first (sample row limit)
# yarn start → NODE_ENV=production; full dumps (BACKUP_DEV_ROW_LIMIT must be 0)
#
# Dev defaults (also in .env.development):
#   BACKUP_ROOT=../.backup-dev
#   BACKUP_VOLUME_META=volumes/meta
#   BACKUP_VOLUME_HIS=volumes/his
#   BACKUP_VOLUME_EMR=volumes/emr
#   BACKUP_DEV_ROW_LIMIT=100
#
# Production Windows worker (absolute disks; root optional if all volumes absolute):
# BACKUP_VOLUME_META=C:\backup-meta
# BACKUP_VOLUME_HIS=D:\his-backup
# BACKUP_VOLUME_EMR=E:\emr-backup
# BACKUP_DEV_ROW_LIMIT=0
#
# Legacy: BACKUP_DIR is treated as BACKUP_ROOT when BACKUP_ROOT is unset.
BACKUP_ROOT=../.backup-dev
BACKUP_VOLUME_META=volumes/meta
BACKUP_VOLUME_HIS=volumes/his
BACKUP_VOLUME_EMR=volumes/emr
BACKUP_VOLUME_LIS=volumes/lis
# Optional: id rows per gzip chunk (default 1000000)
# BACKUP_CHUNK_SIZE=1000000
# Optional: statement timeout ms (0 = none)
# BACKUP_STATEMENT_TIMEOUT_MS=0
# 0 = unlimited (required for yarn start / production). Sample limit lives in .env.development.
BACKUP_DEV_ROW_LIMIT=0

# NestJS backup module (RPO HIS/EMR ≤ 4h)
BACKUP_SCHEDULE_ENABLED=false
# Global incremental fallback (used when group/per-DB cron unset)
# Alias: BACKUP_SCHEDULE_CRON
BACKUP_INCREMENTAL_CRON=0 */4 * * *
# Optional group defaults (override global for all DBs in the group)
BACKUP_HIS_INCREMENTAL_CRON=0 */4 * * *
BACKUP_EMR_INCREMENTAL_CRON=30 */4 * * *
# Optional per-database overrides (examples — unset inherits group/global)
# BACKUP_INCREMENTAL_CRON_produce=0 */4 * * *
# BACKUP_INCREMENTAL_CRON_signer=0 */2 * * *
# BACKUP_INCREMENTAL_CRON_file_service=0 */2 * * *
# BACKUP_INCREMENTAL_CRON_vital_signs=0 */2 * * *
# BACKUP_INCREMENTAL_CRON_research_management=0 */2 * * *
# BACKUP_INCREMENTAL_CRON_medical_incident=0 */2 * * *
# BACKUP_INCREMENTAL_CRON_html_editor=0 */2 * * *
# BACKUP_INCREMENTAL_CRON_phat_thuoc=0 */2 * * *
# Sunday weekly full re-baseline
BACKUP_HIS_FULL_CRON=30 1 * * 0
BACKUP_EMR_FULL_CRON=30 2 * * 0
BACKUP_LIS_INCREMENTAL_CRON=0 */4 * * *
BACKUP_LIS_FULL_CRON=30 3 * * 0
BACKUP_TIMEZONE=Asia/Ho_Chi_Minh
BACKUP_HISTORY_ENABLED=true
# Keep all run artifacts 30 days (chain guard keeps newest baseline forward)
BACKUP_RETENTION_DAYS=30
# Fail /health if last success older than RPO+buffer
BACKUP_FRESHNESS_MAX_AGE_HOURS=5
# none | filesystem | s3 (only none implemented for now)
BACKUP_ARCHIVE_TARGET=none

# LIS (SQL Server on LABSERVER, SQL Server Authentication)
LIS_HOST=192.168.105.2
LIS_PORT=1433
LIS_USER=thongke
LIS_PASSWORD=
LIS_DATABASES=BloodStorage_XanhPon,Labconnect_Card,LabconnXP,LabInventory_XP

# Future sources (optional — ignored when unset)
# PACS_HOST=
# PACS_PORT=5432
# PACS_USER=
# PACS_PASSWORD=
# PACS_DATABASES=

# Redis cache (optional)
REDIS_CACHE_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Optional object storage settings (only needed if related providers are used)
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET_NAME_REGION=
