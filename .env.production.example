NODE_ENV=production

# App
PORT=3000
API_VERSION=v1.0.0
# Swagger is always mounted at /documentation; keep the server reachable only from the LAN.
FALLBACK_LANGUAGE=en

# Auth (required). Generate a fresh RS256 pair for production:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Paste the PEM with literal \n between lines.
JWT_EXPIRATION_TIME=86400
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-rs256-private-key\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-rs256-public-key\n-----END PUBLIC KEY-----"
RESET_TOKEN_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# App database (NestJS / TypeORM) — separate from the HIS/EMR/LIS sources.
# External MySQL reachable from the container. 127.0.0.1 is the container
# itself; use the LAN IP, or host.docker.internal when MySQL runs on the host
# (requires the extra_hosts entry in docker-compose.yml).
# TYPEORM_MIGRATIONS_RUN=true applies migrations and seeds the admin user
# (username admin / password 0123456789) on first boot. Change that password.
# ---------------------------------------------------------------------------
DB_TYPE=mysql
DB_HOST=172.16.16.10
DB_PORT=3306
DB_USERNAME=backup_worker
DB_PASSWORD=change-me
DB_DATABASE=his-raw-backup
TYPEORM_MIGRATIONS_RUN=true

# Encrypts HIS/EMR/LIS/BADL passwords stored in app_settings (required).
# 64-char hex, base64 32-byte, or any long passphrase. Keep it stable: rotating
# it makes previously stored secrets unreadable.
SETTINGS_SECRET_KEY=change-me-to-a-long-random-secret

# ---------------------------------------------------------------------------
# Backup volumes. All paths are inside the container and land on the 10.9 TB
# disk through the /app/backup-storage bind mount in docker-compose.yml.
# Layout written by the engine:
#   meta/backup.lock, meta/runs/<runId>/manifest.json
#   his|emr|lis/state/<db>.json
#   his|emr|lis/runs/<runId>/<db>/{full,append,cdc}/*.csv.gz
# ---------------------------------------------------------------------------
BACKUP_ROOT=/app/backup-storage
BACKUP_VOLUME_META=/app/backup-storage/meta
BACKUP_VOLUME_HIS=/app/backup-storage/his
BACKUP_VOLUME_EMR=/app/backup-storage/emr
BACKUP_VOLUME_LIS=/app/backup-storage/lis

# Must be 0 in production; the app refuses to start otherwise.
BACKUP_DEV_ROW_LIMIT=0
# Optional: id rows per gzip chunk (default 1000000) and statement timeout ms (0 = none)
# BACKUP_CHUNK_SIZE=1000000
# BACKUP_STATEMENT_TIMEOUT_MS=0

# Schedule (Asia/Ho_Chi_Minh). Cron is read at boot; changing it needs a restart.
BACKUP_SCHEDULE_ENABLED=true
BACKUP_TIMEZONE=Asia/Ho_Chi_Minh
# Global incremental fallback when a group/per-DB cron is unset.
BACKUP_INCREMENTAL_CRON=0 */4 * * *
BACKUP_HIS_INCREMENTAL_CRON=0 */4 * * *
BACKUP_EMR_INCREMENTAL_CRON=30 */4 * * *
BACKUP_LIS_INCREMENTAL_CRON=0 */4 * * *
# Sunday weekly full re-baseline.
BACKUP_HIS_FULL_CRON=30 1 * * 0
BACKUP_EMR_FULL_CRON=30 2 * * 0
BACKUP_LIS_FULL_CRON=30 3 * * 0

BACKUP_HISTORY_ENABLED=true
BACKUP_RETENTION_DAYS=30
# GET /health fails when the last successful run is older than this many hours.
BACKUP_FRESHNESS_MAX_AGE_HOURS=5
# none | filesystem | s3 (only none is implemented)
BACKUP_ARCHIVE_TARGET=none

# ---------------------------------------------------------------------------
# Sources. Always use SECONDARY hosts.
#   HIS/EMR: 172.16.16.23
#   BADL:    172.16.16.83
#   LIS:     192.168.105.2 (SQL Server)
# ---------------------------------------------------------------------------
HIS_HOST=172.16.16.23
HIS_PORT=5432
HIS_USER=his_stpaul
HIS_PASSWORD=
HIS_DATABASES=produce

EMR_HOST=172.16.16.23
EMR_PORT=5432
EMR_USER=emr_stpaul
EMR_PASSWORD=
EMR_DATABASES=signer,file_service,vital_signs,research_management,medical_incident,html_editor,phat_thuoc

LIS_HOST=192.168.105.2
LIS_PORT=1433
LIS_USER=thongke
LIS_PASSWORD=
LIS_DATABASES=BloodStorage_XanhPon,Labconnect_Card,LabconnXP,LabInventory_XP

# BADL stays skipped until reachable; leave empty to disable.
BADL_HOST=
BADL_PORT=5432
BADL_USER=
BADL_PASSWORD=
BADL_DATABASES=

# ---------------------------------------------------------------------------
# Helper script only (scripts/mssql-list-databases.ts, not used by the app).
# The app reads the SQL Server source from the LIS_* variables above.
# ---------------------------------------------------------------------------
MSSQL_HOST=192.168.105.2
MSSQL_PORT=1433
MSSQL_USER=thongke
MSSQL_PASSWORD=
MSSQL_DATABASE=master

# ---------------------------------------------------------------------------
# Redis (required for auth sessions). External, reachable from the container.
# ---------------------------------------------------------------------------
REDIS_CACHE_ENABLED=true
REDIS_HOST=172.16.16.10
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Optional object storage (only when BACKUP_ARCHIVE_TARGET=s3, not implemented yet)
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET_NAME_REGION=
