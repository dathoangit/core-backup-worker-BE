NODE_ENV=production

# ---------------------------------------------------------------------------
# Runtime env only (infrastructure). Backup sources, volumes, cron, retention,
# and alert channels live in app_settings — seed once from `.env.settings`
# (see `.env.settings.example`), then manage via FE /config.
# ---------------------------------------------------------------------------

# App
PORT=3000
API_VERSION=v1.0.0
FALLBACK_LANGUAGE=en

# Auth (required). Generate a fresh RS256 pair for production:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private.pem
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Paste the PEM with literal \n between lines.
JWT_EXPIRATION_TIME=86400
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-rs256-private-key\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-rs256-public-key\n-----END PUBLIC KEY-----"
RESET_TOKEN_TTL_MINUTES=30
# FRONTEND_ORIGINS=https://backup.example.local

# App database (NestJS / TypeORM) — separate from HIS/EMR/LIS sources.
# TYPEORM_MIGRATIONS_RUN=true applies migrations and seeds the admin user
# (username admin / password 0123456789) on first boot. Change that password.
DB_TYPE=mysql
DB_HOST=172.16.16.10
DB_PORT=3306
DB_USERNAME=backup_worker
DB_PASSWORD=change-me
DB_DATABASE=his-raw-backup
TYPEORM_MIGRATIONS_RUN=true

# Encrypts *_PASSWORD values in app_settings (required). Keep stable after seed.
# 64-char hex, base64 32-byte, or any long passphrase.
SETTINGS_SECRET_KEY=change-me-to-a-long-random-secret

# One-shot bootstrap file (default `.env.settings` in cwd). First boot with an
# empty app_settings table loads allowlisted keys from this file and encrypts
# secrets. Optional after seed — may delete the file from the host.
SETTINGS_SEED_FILE=.env.settings

# Redis (auth sessions + BullMQ backup queue)
REDIS_CACHE_ENABLED=true
REDIS_HOST=172.16.16.10
REDIS_PORT=6379
REDIS_DB=0
REDIS_BULL_DB=1
REDIS_PASSWORD=
