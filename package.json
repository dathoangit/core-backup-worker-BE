{
  "name": "awesome-nestjs-boilerplate",
  "version": "10.0.0",
  "description": "Awesome NestJS Boilerplate, Typescript, Postgres, TypeORM",
  "author": "Narek Hakobyan <narek.hakobyan.07@gmail.com>",
  "private": true,
  "license": "MIT",
  "scripts": {
    "deploy": "./deploy.sh",
    "build:prod": "nest build",
    "prod": "node dist/main.js",
    "start": "cross-env NODE_ENV=production nest start",
    "start:prod": "cross-env NODE_ENV=production node dist/main.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "yarn run typeorm migration:generate -d ormconfig",
    "migration:create": "yarn run typeorm migration:create -d ormconfig",
    "migration:run": "yarn run typeorm migration:run -d ormconfig",
    "new": "hygen new",
    "migration:revert": "yarn run typeorm migration:revert -d ormconfig",
    "schema:drop": "yarn run typeorm schema:drop -d ormconfig",
    "dev": "cross-env NODE_ENV=development BACKUP_PROFILE=dev nest start --watch",
    "debug:dev": "cross-env NODE_ENV=development TS_NODE_CACHE=false ts-node-dev --inspect --ignore '/^src/.*\\.spec\\.ts$/' src/main.ts",
    "backup:ensure-volumes": "node scripts/ensure-backup-volumes.js",
    "settings:sync-from-env": "node -r ts-node/register/transpile-only scripts/sync-settings-from-env.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint --fix . --ext .ts",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:cov": "NODE_ENV=test jest --coverage",
    "test:debug": "NODE_ENV=test node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json",
    "backup:run": "node -r ts-node/register/transpile-only src/modules/backup/backup-cli.ts",
    "mssql:list-databases": "node -r ts-node/register/transpile-only scripts/mssql-list-databases.ts",
    "lis:trial": "node -r ts-node/register/transpile-only scripts/lis-trial-backup.ts",
    "backup:test": "NODE_ENV=test jest --testPathPattern=modules/backup",
    "prepare": "husky install",
    "release": "release-it"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.485.0",
    "@mysten/sui.js": "^0.50.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/cqrs": "^10.2.6",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^5.1.1",
    "@nestjs/typeorm": "^10.0.1",
    "bcrypt": "5.1.1",
    "class-transformer": "~0.5.1",
    "class-validator": "~0.14.0",
    "compression": "^1.7.4",
    "cron": "3.2.1",
    "dotenv": "^18.0.5",
    "ethers": "5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "input": "^1.0.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mime-types": "^2.1.35",
    "morgan": "^1.10.0",
    "mssql": "^12.7.6",
    "mysql2": "^3.22.0",
    "nestjs-cls": "^3.6.0",
    "parse-duration": "^1.1.0",
    "passport": "^0.6.0",
    "passport-custom": "1.1.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "pg-copy-streams": "^7.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "source-map-support": "^0.5.21",
    "swagger-ui-express": "^5.0.0",
    "tslib": "^2.6.2",
    "typeorm": "^0.3.19",
    "typeorm-transactional": "~0.5.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@handfish/hygen": "^6.1.6",
    "@nestjs/cli": "^10.2.1",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.202",
    "@types/mime-types": "^2.1.4",
    "@types/morgan": "^1.9.9",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.10.6",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^3.0.13",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-canonical": "^4.18.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-import-helpers": "^1.3.1",
    "eslint-plugin-n": "^16.6.1",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-sonarjs": "^0.23.0",
    "eslint-plugin-unicorn": "^50.0.1",
    "gh-pages": "^6.1.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "~15.2.0",
    "prettier": "^3.1.1",
    "release-it": "^17.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.3",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "types": [
              "jest",
              "node"
            ]
          }
        }
      ]
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
